diff --git a/src/hle/rt64_state.cpp b/src/hle/rt64_state.cpp
index 4a8bf75..1c660c1 100644
--- a/src/hle/rt64_state.cpp
+++ b/src/hle/rt64_state.cpp
@@ -35,6 +35,78 @@
 #define MI_INTR_SP          0x00000001
 
 namespace RT64 {
+    static std::atomic<bool> translucentSort{ false };
+
+    void setTranslucentSort(bool enabled) {
+        translucentSort.store(enabled, std::memory_order_relaxed);
+    }
+
+    // Rush 2049 patch: a game that draws see-through surfaces (blended, Z compare without Z update) in among the rest of
+    // its scene leaves them to whatever is drawn after: on a console as here, a surface drawn later and farther away
+    // passes the depth test where the see-through one is and paints over it, since the see-through one wrote no depth.
+    // Rush 2049 draws its scenery node by node, a model's see-through parts beside its solid ones, so a tree of
+    // see-through leaves goes missing wherever a building behind it is drawn after it. With translucentSort set, each
+    // perspective projection's see-through calls are drawn after its other calls, in the order the game drew them, so
+    // they blend over everything solid behind them and are hidden by everything solid in front. Their order among
+    // themselves is kept: an effect drawn in layers (an exhaust flame's glow over its core) depends on it, and sorting
+    // them by depth turned such layers over. So two see-through surfaces still cover each other as the game drew them.
+    // Left in place: a call inside a VertexTestZ pair, whose draws depend on the test before them, and a call sampling
+    // a framebuffer copy, which must come after the draws it copies.
+    static bool isTranslucentCall(const Workload &workload, const GameCall &call) {
+        const DrawCall &desc = call.callDesc;
+        const interop::OtherMode &otherMode = desc.otherMode;
+        const uint32_t cycleType = otherMode.cycleType();
+        if ((desc.extendedType != DrawExtendedType::None) || (desc.triangleCount == 0) || (cycleType == G_CYC_FILL) ||
+            (cycleType == G_CYC_COPY) || !otherMode.zCmp() || otherMode.zUpd() || (otherMode.zMode() != ZMODE_XLU) ||
+            !otherMode.forceBlend())
+        {
+            return false;
+        }
+
+        for (uint32_t t = 0; t < desc.tileCount; t++) {
+            if (workload.drawData.callTiles[desc.tileIndex + t].tileCopyUsed) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    static void sortTranslucentCalls(Workload &workload, Projection &proj) {
+        if ((proj.type != Projection::Type::Perspective) || (proj.gameCallCount < 2)) {
+            return;
+        }
+
+        thread_local std::vector<GameCall> solid;
+        thread_local std::vector<GameCall> translucent;
+        solid.clear();
+        translucent.clear();
+        bool insideTestZ = false;
+        for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+            const GameCall &call = proj.gameCalls[d];
+            if (call.callDesc.extendedType == DrawExtendedType::VertexTestZ) {
+                insideTestZ = true;
+            }
+            else if (call.callDesc.extendedType == DrawExtendedType::EndVertexTestZ) {
+                insideTestZ = false;
+            }
+
+            if (!insideTestZ && isTranslucentCall(workload, call)) {
+                translucent.emplace_back(call);
+            }
+            else {
+                solid.emplace_back(call);
+            }
+        }
+
+        if (translucent.empty() || solid.empty()) {
+            return;
+        }
+
+        std::copy(solid.begin(), solid.end(), proj.gameCalls.begin());
+        std::copy(translucent.begin(), translucent.end(), proj.gameCalls.begin() + solid.size());
+    }
+
     const float ShiftScaleMap[] = {
         1.0f,
         1.0f / 2.0f,
@@ -1357,6 +1429,16 @@ namespace RT64 {
             }
         }
 
+        // Rush 2049 patch: see-through surfaces after the rest of their view (sortTranslucentCalls).
+        if (translucentSort.load(std::memory_order_relaxed)) {
+            for (uint32_t f = 0; f < workload.fbPairCount; f++) {
