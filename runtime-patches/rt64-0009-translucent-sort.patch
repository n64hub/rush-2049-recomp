+                    sortTranslucentCalls(workload, fbPair.projections[p]);
+                }
+            }
+        }
+
         // Ensure there's as many GPU tiles as call tiles available in the vector.
         workload.drawData.gpuTiles.resize(workload.drawData.callTiles.size());
 
