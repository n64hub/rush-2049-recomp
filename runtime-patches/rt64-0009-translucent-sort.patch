+    void setTranslucentSort(bool enabled) {
+        translucentSort.store(enabled, std::memory_order_relaxed);
+    }
+
+    // Rush 2049 patch: a game that draws see-through surfaces (blended, Z compare without Z update) in among the rest of
+    // its scene leaves them to whatever is drawn after: on a console as here, a surface drawn later and farther away
+    // passes the depth test where the see-through one is and paints over it, since the see-through one wrote no depth.
+    // Rush 2049 draws its scenery node by node, a model's see-through parts beside its solid ones, so a tree of
+    // see-through leaves goes missing wherever a building behind it is drawn after it, and the sail of a boat drawn after
+    // a street lamp in the same list covers the lamp's pole. With translucentSort set, each perspective projection's
+    // see-through calls are drawn after its other calls, the farthest first, and each such call's triangles are put in
+    // the same order, by the mean screen depth of their vertices (a vertex behind the camera counts as nearest). A
+    // homogeneous matrix divided through (Rush 2049's Draw Distance) leaves that depth as it was. Every other call keeps
+    // its place and its order, and so does a call inside a VertexTestZ pair, whose draws depend on the test before them.
+    static bool isTranslucentCall(const GameCall &call) {
+        const DrawCall &desc = call.callDesc;
+        const interop::OtherMode &otherMode = desc.otherMode;
+        const uint32_t cycleType = otherMode.cycleType();
+        return (desc.extendedType == DrawExtendedType::None) && (desc.triangleCount > 0) && (cycleType != G_CYC_FILL) &&
+            (cycleType != G_CYC_COPY) && otherMode.zCmp() && !otherMode.zUpd() && (otherMode.zMode() == ZMODE_XLU) &&
+            otherMode.forceBlend();
+    }
+
+    static void sortTranslucentCalls(Workload &workload, Projection &proj) {
+        if ((proj.type != Projection::Type::Perspective) || (proj.gameCallCount < 2)) {
+            return;
+        }
+
+        std::vector<uint32_t> &faceIndices = workload.drawData.faceIndices;
+        const std::vector<hlslpp::float4> &posTransformed = workload.drawData.posTransformed;
+        const std::vector<hlslpp::float3> &posScreen = workload.drawData.posScreen;
+        thread_local std::vector<std::pair<float, uint32_t>> order;
+        thread_local std::vector<uint32_t> faceCopy;
+        thread_local std::vector<GameCall> sorted;
+        auto triangleDepth = [&](uint32_t start) {
+            float sum = 0.0f;
+            for (uint32_t i = 0; i < 3; i++) {
+                const uint32_t v = faceIndices[start + i];
+                const float w = posTransformed[v][3];
+                if (!(w > 0.0f)) {
+                    return -FLT_MAX;
+                }
+
+                sum += posScreen[v][2];
+            }
+
+            return sum / 3.0f;
+        };
+
+        std::vector<std::pair<float, uint32_t>> deferred;
+        bool insideTestZ = false;
+        for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+            const GameCall &call = proj.gameCalls[d];
+            if (call.callDesc.extendedType == DrawExtendedType::VertexTestZ) {
+                insideTestZ = true;
+            }
+            else if (call.callDesc.extendedType == DrawExtendedType::EndVertexTestZ) {
+                insideTestZ = false;
+            }
+
+            if (insideTestZ || !isTranslucentCall(call)) {
+                continue;
+            }
+
+            const uint32_t start = call.meshDesc.faceIndicesStart;
+            const uint32_t triangleCount = call.callDesc.triangleCount;
+            order.clear();
+            double sum = 0.0;
+            for (uint32_t t = 0; t < triangleCount; t++) {
+                const float depth = triangleDepth(start + t * 3);
+                order.emplace_back(depth, t);
+                sum += (depth == -FLT_MAX) ? 0.0 : depth;
+            }
+
+            if (triangleCount > 1) {
+                std::stable_sort(order.begin(), order.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+                faceCopy.assign(faceIndices.begin() + start, faceIndices.begin() + start + triangleCount * 3);
+                for (uint32_t t = 0; t < triangleCount; t++) {
+                    std::copy_n(faceCopy.begin() + order[t].second * 3, 3, faceIndices.begin() + start + t * 3);
+                }
+            }
+
+            deferred.emplace_back(float(sum / triangleCount), d);
+        }
+
+        if (deferred.empty()) {
+            return;
+        }
+
+        std::stable_sort(deferred.begin(), deferred.end(), [](const auto &a, const auto &b) { return a.first > b.first; });
+        sorted.clear();
+        size_t next = 0;
+        std::vector<bool> moved(proj.gameCallCount, false);
+        for (const auto &entry : deferred) {
+            moved[entry.second] = true;
+        }
+
+        for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+            if (!moved[d]) {
+                sorted.emplace_back(proj.gameCalls[d]);
+            }
+        }
+
+        for (const auto &entry : deferred) {
+            sorted.emplace_back(proj.gameCalls[entry.second]);
+        }
+
+        std::copy(sorted.begin(), sorted.end(), proj.gameCalls.begin());
+    }
