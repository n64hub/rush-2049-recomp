 namespace RT64 {
+    static std::atomic<uint32_t> translucentSortDepth{ 0 };
+
+    void setTranslucentSort(uint32_t minListDepth) {
+        translucentSortDepth.store(minListDepth, std::memory_order_relaxed);
+    }
+
+    // Rush 2049 patch: a game that draws see-through surfaces (blended, Z compare without Z update) in among the rest of
+    // its scene leaves them to whatever is drawn after: on a console as here, a surface drawn later and farther away
+    // passes the depth test where the see-through one is and paints over it, since the see-through one wrote no depth.
+    // Rush 2049 draws its scenery node by node, a model's see-through parts beside its solid ones, so a tree of
+    // see-through leaves goes missing wherever a building behind it is drawn after it. With translucentSortDepth set,
+    // each perspective projection's see-through calls drawn at least that many display lists deep are drawn after its
+    // other calls, in the order the game drew them, so they blend over everything solid behind them and are hidden by
+    // everything solid in front. Their order among themselves is kept, so two see-through surfaces still cover each
+    // other as the game drew them: sorting them by depth turned an exhaust flame's layers over.
+    // The depth is what keeps this to scenery. Rush 2049's root list calls a list per scene node, which calls the
+    // node's model, so the track's scenery and the other cars are two lists deep; its effects (the player's car and its
+    // flame, the flame's trail, shadows, smoke) are lists the root list calls itself, one deep, and are built from
+    // see-through and solid layers drawn in an order they depend on, which moving their see-through layers broke.
+    // Left in place as well: a call inside a VertexTestZ pair, whose draws depend on the test before them, and a call
+    // sampling a framebuffer copy, which must come after the draws it copies.
+    static bool isTranslucentCall(const Workload &workload, const GameCall &call, uint32_t minListDepth) {
+        const DrawCall &desc = call.callDesc;
+        if ((desc.minListDepth == UINT8_MAX) || (desc.minListDepth < minListDepth)) {
+            return false;
+        }
+
+        const interop::OtherMode &otherMode = desc.otherMode;
+        const uint32_t cycleType = otherMode.cycleType();
+        if ((desc.extendedType != DrawExtendedType::None) || (desc.triangleCount == 0) || (cycleType == G_CYC_FILL) ||
+            (cycleType == G_CYC_COPY) || !otherMode.zCmp() || otherMode.zUpd() || (otherMode.zMode() != ZMODE_XLU) ||
+            !otherMode.forceBlend())
+        {
+            return false;
+        }
+
+        for (uint32_t t = 0; t < desc.tileCount; t++) {
+            if (workload.drawData.callTiles[desc.tileIndex + t].tileCopyUsed) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+
+    static void sortTranslucentCalls(Workload &workload, Projection &proj, uint32_t minListDepth) {
+        if ((proj.type != Projection::Type::Perspective) || (proj.gameCallCount < 2)) {
+            return;
+        }
+
+        thread_local std::vector<GameCall> solid;
+        thread_local std::vector<GameCall> translucent;
+        solid.clear();
+        translucent.clear();
+        bool insideTestZ = false;
+        for (uint32_t d = 0; d < proj.gameCallCount; d++) {
+            const GameCall &call = proj.gameCalls[d];
+            if (call.callDesc.extendedType == DrawExtendedType::VertexTestZ) {
+                insideTestZ = true;
+            }
+            else if (call.callDesc.extendedType == DrawExtendedType::EndVertexTestZ) {
+                insideTestZ = false;
+            }
+
+            if (!insideTestZ && isTranslucentCall(workload, call, minListDepth)) {
+                translucent.emplace_back(call);
+            }
+            else {
+                solid.emplace_back(call);
+            }
+        }
+
+        if (translucent.empty() || solid.empty()) {
+            return;
+        }
+
+        std::copy(solid.begin(), solid.end(), proj.gameCalls.begin());
+        std::copy(translucent.begin(), translucent.end(), proj.gameCalls.begin() + solid.size());
+    }
