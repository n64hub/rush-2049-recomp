+    // Sets the bits of the 64-byte blocks [start, end) touches.
+    static void markLoadBlocks(std::vector<uint64_t> &blocks, uint64_t start, uint64_t end) {
+        uint64_t b = start >> 6;
+        const uint64_t e = (end + 63) >> 6;
+        while (b < e) {
+            const uint64_t bit = b & 63;
+            const uint64_t n = std::min<uint64_t>(64 - bit, e - b);
+            blocks[b >> 6] |= (n == 64) ? ~0ULL : (((1ULL << n) - 1) << bit);
+            b += n;
+        }
+    }
