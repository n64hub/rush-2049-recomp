+    // Copies the bytes of RDRAM the loads from loadOpCursor on read into loadRAM, at their own addresses. False if one reads
+    // past the end of RDRAM, which is then left to RDRAM itself on the list thread.
+    bool State::copyLoadRAM(const Workload &workload, uint32_t loadOpCursor) {
+        const uint64_t ramBytes = uint64_t(RDRAMSize) + 1;
+        const std::vector<LoadOperation> &loadOps = workload.drawData.loadOperations;
+        loadRAMRanges.clear();
+        for (size_t i = loadOpCursor; i < loadOps.size(); i++) {
+            uint64_t start, end;
+            RDP::loadSourceRange(loadOps[i], start, end);
+            if (end > ramBytes) {
+                return false;
+            }
+
+            loadRAMRanges.emplace_back(start, end);
+        }
+
+        // A split-screen list loads each texture once a view: the ranges are merged so each byte is copied once.
+        std::sort(loadRAMRanges.begin(), loadRAMRanges.end());
+        if (loadRAM.size() < ramBytes) {
+            loadRAM.resize(ramBytes);
+        }
+
+        size_t r = 0;
+        while (r < loadRAMRanges.size()) {
+            const uint64_t start = loadRAMRanges[r].first;
+            uint64_t end = loadRAMRanges[r].second;
+            for (r++; (r < loadRAMRanges.size()) && (loadRAMRanges[r].first <= end); r++) {
+                end = std::max(end, loadRAMRanges[r].second);
+            }
+
+            memcpy(&loadRAM[start], &RDRAM[start], end - start);
+        }
+
+        return true;
+    }
