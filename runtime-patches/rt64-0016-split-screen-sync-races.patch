+    // Rush 2049 patch: the bytes of RDRAM a load reads, rounded out to 8 bytes, worked out as the three operations below
+    // work out where they read (a word reads within the 8 bytes from its address, a TLUT word within the first two).
+    void RDP::loadSourceRange(const LoadOperation &loadOp, uint64_t &start, uint64_t &end) {
+        const LoadTile &loadTile = loadOp.tile;
+        const LoadTexture &loadTexture = loadOp.texture;
+        const uint32_t bytesPerRow = loadTexture.width << loadTexture.siz >> 1;
+        uint32_t textureStart = 0;
+        uint64_t byteCount = 0;
+        switch (loadOp.type) {
+        case LoadOperation::Type::Block: {
+            const uint32_t bytesOffset = loadTile.uls << loadTexture.siz >> 1;
+            const uint32_t wordCount = ((loadTile.lrs - loadTile.uls) >> (4 - loadTile.siz)) + 1;
+            textureStart = loadTexture.address + bytesOffset + bytesPerRow * loadTile.ult;
+            byteCount = uint64_t(wordCount) << 3;
+            break;
+        }
+        case LoadOperation::Type::Tile:
+        case LoadOperation::Type::TLUT: {
+            const uint32_t bytesOffset = (loadTile.uls >> 2) << loadTexture.siz >> 1;
+            const uint32_t rowCount = 1 + ((loadTile.lrt >> 2) - (loadTile.ult >> 2));
+            const uint32_t tileWidth = ((loadTile.lrs >> 2) - (loadTile.uls >> 2));
+            const uint32_t wordsPerRow = (loadOp.type == LoadOperation::Type::Tile) ? ((tileWidth >> (4 - loadTile.siz)) + 1) : (tileWidth + 1);
+            textureStart = loadTexture.address + bytesOffset + bytesPerRow * (loadTile.ult >> 2);
+            byteCount = uint64_t(rowCount - 1) * bytesPerRow + (uint64_t(wordsPerRow) << 3);
+            break;
+        }
+        }
+
+        start = textureStart & ~uint64_t(7);
+        end = (uint64_t(textureStart) + byteCount + 7) & ~uint64_t(7);
+    }
