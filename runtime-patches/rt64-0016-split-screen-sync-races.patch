+    // Copies the bytes of RDRAM the loads from loadOpCursor on read into loadRAM, at their own addresses, in the 64-byte
+    // blocks they touch: a split-screen list loads each texture once a view, and a tile a few rows of a wider texture, so
+    // the blocks are marked row by row first and each is copied once. False if a load reads past the end of RDRAM, which
+    // is then left to RDRAM itself on the list thread.
+    bool State::copyLoadRAM(const Workload &workload, uint32_t loadOpCursor) {
+        const uint64_t ramBytes = uint64_t(RDRAMSize) + 1;
+        const uint64_t blockCount = ramBytes >> 6;
+        const std::vector<LoadOperation> &loadOps = workload.drawData.loadOperations;
+        loadRAMBlocks.assign(blockCount >> 6, 0);
+        for (size_t i = loadOpCursor; i < loadOps.size(); i++) {
+            uint32_t start, rowBytes, stride, rowCount;
+            RDP::loadSourceRows(loadOps[i], start, rowBytes, stride, rowCount);
+            const uint64_t end = uint64_t(start) + uint64_t(rowCount - 1) * stride + rowBytes;
+            if (end > ramBytes) {
+                return false;
+            }
+
+            if ((rowCount == 1) || (stride <= (uint64_t(rowBytes) + 64))) {
+                markLoadBlocks(loadRAMBlocks, start, end);
+            }
+            else {
+                for (uint32_t r = 0; r < rowCount; r++) {
+                    const uint64_t rowStart = uint64_t(start) + uint64_t(r) * stride;
+                    markLoadBlocks(loadRAMBlocks, rowStart, rowStart + rowBytes);
+                }
+            }
+        }
+
+        if (loadRAM.size() < ramBytes) {
+            loadRAM.resize(ramBytes);
+        }
+
+        uint64_t b = 0;
+        while (b < blockCount) {
+            const uint64_t rest = loadRAMBlocks[b >> 6] >> (b & 63);
+            if ((rest & 1) == 0) {
+                b = (rest == 0) ? ((b | 63) + 1) : (b + 1);
+                continue;
+            }
+
+            uint64_t e = b + 1;
+            while ((e < blockCount) && ((loadRAMBlocks[e >> 6] >> (e & 63)) & 1)) {
+                e++;
+            }
+
+            memcpy(&loadRAM[b << 6], &RDRAM[b << 6], (e - b) << 6);
+            b = e;
+        }
+
+        return true;
+    }
