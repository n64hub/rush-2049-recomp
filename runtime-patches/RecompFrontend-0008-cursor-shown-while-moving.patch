 static std::atomic_bool cursor_enabled = true;
 static std::atomic_bool cursor_always_visible = false;
+static std::atomic_bool cursor_shown_while_moving = false;
+// steady_clock ticks of the last mouse motion; 0 is long ago, so the cursor starts hidden.
+static std::atomic<std::chrono::steady_clock::rep> last_mouse_motion = 0;
+static constexpr std::chrono::seconds cursor_still_hide_delay{2};
 
 void recompui::open_quit_game_prompt() {
     recompui::open_choice_prompt(
@@ -69,7 +73,14 @@
 }
 
 bool recompui::get_cursor_visible() {
-    return cursor_enabled.load() || cursor_always_visible.load();
+    if (cursor_always_visible.load()) {
+        return true;
+    }
+    if (cursor_shown_while_moving.load()) {
+        std::chrono::steady_clock::duration still{std::chrono::steady_clock::now().time_since_epoch().count() - last_mouse_motion.load()};
+        return still < cursor_still_hide_delay;
+    }
+    return cursor_enabled.load();
 }
 void recompui::set_cursor_visible(bool visible) {
     cursor_enabled.store(visible);
@@ -77,6 +88,12 @@
 void recompui::set_cursor_always_visible(bool always_visible) {
     cursor_always_visible.store(always_visible);
 }
+void recompui::set_cursor_shown_while_moving(bool while_moving) {
+    cursor_shown_while_moving.store(while_moving);
+}
+void recompui::note_mouse_moved() {
+    last_mouse_motion.store(std::chrono::steady_clock::now().time_since_epoch().count());
+}
 
