+    // G_CULLDL ends the display list when vertices vstart to vend (a bounding box the game loaded) all lie outside one
+    // side of the view: past the left, right, top or bottom edge, or behind the near plane. Each side is a plane in clip
+    // space, so a box whose corners are all beyond one holds nothing in view, even with corners behind the camera. Sideways the view is the one RT64 shows, not the game's: Aspect Ratio widens the
+    // projection after the game's 4:3 one, so x is tested against the window's width (or a set ratio) over 4:3. Every
+    // side is a quarter wider than that, so an object at the edge is still drawn in the frames interpolated between two
+    // of the game's, where the camera has moved on.
+    void RSP::cullDl(uint32_t vstart, uint32_t vend, DisplayList **dl) {
+        if ((vstart > vend) || (vend >= RSP_MAX_VERTICES)) {
+            return;
+        }
+
+        const UserConfiguration &userConfig = *state->ext.userConfig;
+        float aspect = 4.0f / 3.0f;
+        if (userConfig.aspectRatio == UserConfiguration::AspectRatio::Manual) {
+            aspect = std::max(aspect, float(userConfig.aspectTarget));
+        }
+        else if (userConfig.aspectRatio == UserConfiguration::AspectRatio::Expand) {
+            const SharedQueueResources *shared = state->ext.sharedQueueResources;
+            if ((shared->swapChainWidth > 0) && (shared->swapChainHeight > 0)) {
+                aspect = std::max(aspect, float(shared->swapChainWidth) / float(shared->swapChainHeight));
+            }
+        }
+
+        const float Margin = 1.25f;
+        const float xBound = Margin * aspect * 0.75f;
+        const float yBound = Margin;
+        const Workload &workload = state->ext.workloadQueue->workloads[state->ext.workloadQueue->writeCursor];
+        uint32_t outside = 0x1F;
+        for (uint32_t i = vstart; (i <= vend) && (outside != 0); i++) {
+            const hlslpp::float4 &p = workload.drawData.posTransformed[indices[i]];
+            const float x = p[0], y = p[1], z = p[2], w = p[3];
+            uint32_t sides = 0;
+            sides |= (x < -xBound * w) ? 0x1 : 0x0;
+            sides |= (x > xBound * w) ? 0x2 : 0x0;
+            sides |= (y < -yBound * w) ? 0x4 : 0x0;
+            sides |= (y > yBound * w) ? 0x8 : 0x0;
+            sides |= (z < -w) ? 0x10 : 0x0;
+            outside &= sides;
+        }
+
+        if (outside != 0) {
+            *dl = state->popReturnAddress();
+        }
+    }
+
