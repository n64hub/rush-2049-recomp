+int players::get_player_controller_profile_index(int player_index, bool temp_player) {
+    PlayerArray& player_array = PlayerState.get_player_array(temp_player);
+    SDL_GameController* controller = player_array[player_index].controller;
+    int profile_index = profiles::get_controller_profile_index_from_sdl_controller(controller);
+    if (profile_index < 0) {
+        return -1;
+    }
+    uint64_t hash = profiles::get_guid_from_sdl_controller(controller).hash;
+    int number = 1;
+    for (int i = 0; i < player_index; i++) {
+        if (player_array[i].controller != nullptr && profiles::get_guid_from_sdl_controller(player_array[i].controller).hash == hash) {
+            number++;
+        }
+    }
+    return number == 1 ? profile_index : profiles::get_or_create_numbered_controller_profile_index(profile_index, number);
+}
+
+int players::get_controller_profile_index(SDL_GameController* controller) {
+    for (size_t i = 0; i < PlayerState.players.get_count(); i++) {
+        if (controller != nullptr && PlayerState.players[i].controller == controller) {
+            return players::get_player_controller_profile_index((int)i);
+        }
+    }
+    return profiles::get_controller_profile_index_from_sdl_controller(controller);
+}
