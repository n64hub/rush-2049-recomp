diff --git a/src/common/rt64_gpu_timings.h b/src/common/rt64_gpu_timings.h
new file mode 100644
index 0000000..e02dc54
--- /dev/null
+++ b/src/common/rt64_gpu_timings.h
@@ -0,0 +1,130 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <iterator>
+#include <mutex>
+#include <vector>
+
+#include "common/rt64_plume.h"
+
+namespace RT64 {
+    // GPU time of every frame, in milliseconds, collected only while a host has turned it on (to measure settings).
+    // render: the workload queue's frame, game and interpolated frames alike. present: the VI pass that draws
+    // the frame into the swap chain.
+    struct GPUTimings {
+        // Where a rendered frame's time goes, summed over every frame collected.
+        enum RenderPart {
+            RenderUploads,      // Copying the frame's buffers (draw data, interpolated transforms and tiles) to the GPU.
+            RenderVertices,     // The RSP and world vertex compute passes.
+            RenderSetup,        // The rest of the setup: shader buffer barriers and dynamic texture barriers.
+            RenderFbOperations, // Framebuffer operations and copies from RDRAM or other targets into a target.
+            RenderDraws,        // The draw calls of every framebuffer pair.
+            RenderResolves,     // Barriers after each pair's draws and MSAA resolves.
+            RenderPartCount
+        };
+
+        // Where a present pass's time goes, summed over every present collected.
+        enum PresentPart {
+            PresentResolve,     // MSAA resolve or downsample of the frame.
+            PresentVI,          // Clearing the swap chain and drawing the frame into it.
+            PresentUI,          // The host's draw hook (its UI) and the inspector.
+            PresentPartCount
+        };
+
+        std::mutex mutex;
+        bool enabled = false;
+        std::vector<double> render;
+        std::vector<double> present;
+        double renderParts[RenderPartCount] = {};
+        double presentParts[PresentPartCount] = {};
+        uint64_t framebuffers = 0;
+        uint64_t drawCalls = 0;
+
+        void add(std::vector<double> &samples, double ms) {
+            std::scoped_lock lock(mutex);
+            if (enabled) {
+                samples.push_back(ms);
+            }
+        }
+
+        bool isEnabled() {
+            std::scoped_lock lock(mutex);
+            return enabled;
+        }
+
+        void clear() {
+            render.clear();
+            present.clear();
+            std::fill(std::begin(renderParts), std::end(renderParts), 0.0);
+            std::fill(std::begin(presentParts), std::end(presentParts), 0.0);
+            framebuffers = 0;
+            drawCalls = 0;
+        }
+    };
+
+    inline GPUTimings gpuTimings;
+
+    // Times one command list with a timestamp at its start and its end, and while timings are on, one more at the
+    // end of each part of it (mark), so each part's time is added to the sums once the command list has run.
+    // Code that records into a timed command list without holding its timer (the framebuffer renderer) marks the
+    // end of a part with markGPUPart, which goes to the timer recording on the same thread, if any.
+    struct GPUPartTimer;
+    inline thread_local GPUPartTimer *recordingGPUPartTimer = nullptr;
+
+    struct GPUPartTimer {
+        RenderCommandList *commandList = nullptr;
+        RenderQueryPool *queryPool = nullptr;
+        std::vector<uint32_t> parts; // The part each timestamp after the first one ends.
+        bool detailed = false;
+
+        void begin(RenderCommandList *commandList, RenderQueryPool *queryPool) {
+            this->commandList = commandList;
+            this->queryPool = queryPool;
+            parts.clear();
+            detailed = gpuTimings.isEnabled();
+            commandList->writeTimestamp(queryPool, 0);
+            recordingGPUPartTimer = this;
+        }
+
+        void mark(uint32_t part) {
+            // Keep the pool's last query for end().
+            if (detailed && (parts.size() + 2 < queryPool->getCount())) {
+                parts.push_back(part);
+                commandList->writeTimestamp(queryPool, uint32_t(parts.size()));
+            }
+        }
+
+        void end(uint32_t part) {
+            parts.push_back(part);
+            commandList->writeTimestamp(queryPool, uint32_t(parts.size()));
+            recordingGPUPartTimer = nullptr;
+        }
+
+        // Once the command list has run: adds each part's time to sums and returns the total in milliseconds.
+        double collect(double *sums) {
+            queryPool->queryFirstResults(uint32_t(parts.size() + 1));
+            const uint64_t *timestamps = queryPool->getResults();
+            if (detailed) {
+                std::scoped_lock lock(gpuTimings.mutex);
+                if (gpuTimings.enabled) {
+                    for (size_t i = 0; i < parts.size(); i++) {
+                        sums[parts[i]] += double(timestamps[i + 1] - timestamps[i]) / 1000000.0;
+                    }
+                }
+            }
+
+            return double(timestamps[parts.size()] - timestamps[0]) / 1000000.0;
+        }
+    };
+
+    inline void markGPUPart(uint32_t part) {
+        if (recordingGPUPartTimer != nullptr) {
+            recordingGPUPartTimer->mark(part);
+        }
+    }
+};
