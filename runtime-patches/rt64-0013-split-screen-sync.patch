+    // The one load every byte of a span came from, or 0 when there is none: a byte no load wrote in this sync, two
+    // loads, or a span that wraps around TMEM.
+    static uint32_t spanTag(const uint32_t *tags, uint32_t start, uint32_t count, uint32_t limit) {
+        if ((count == 0) || ((start + count) > limit)) {
+            return 0;
+        }
+
+        const uint32_t first = start >> 2;
+        const uint32_t last = (start + count - 1) >> 2;
+        const uint32_t tag = tags[first];
+        uint32_t differ = 0;
+        for (uint32_t u = first + 1; u <= last; u++) {
+            differ |= tags[u] ^ tag;
+        }
+
+        return (differ == 0) ? tag : 0;
+    }
+
+    // A key for a tile's hash made of the loads its bytes came from and what the hash reads of the tile, or 0 if some of
+    // its bytes didn't all come from one load. Within a full sync a load reads the same RDRAM each time, so the same
+    // loads leave the same bytes where the tile reads them.
+    uint64_t TextureManager::syncHashKey(const uint32_t *tags, const LoadTile &loadTile, uint16_t width, uint16_t height, uint32_t tlut) {
+        const uint32_t TMEMBytes = 4096;
+        const bool RGBA32 = (loadTile.siz == G_IM_SIZ_32b) && (loadTile.fmt == G_IM_FMT_RGBA);
+        const bool usesTLUT = tlut > 0;
+        const bool halfTMEM = RGBA32 || usesTLUT;
+        const uint32_t tmemSize = halfTMEM ? (TMEMBytes >> 1) : TMEMBytes;
+        const uint32_t drawBytesPerRow = std::max(uint32_t(width) << (RGBA32 ? G_IM_SIZ_16b : loadTile.siz) >> 1U, 1U);
+        const uint32_t drawBytesTotal = (loadTile.line << 3) * (height - 1) + drawBytesPerRow;
+        const uint32_t tmemAddress = (loadTile.tmem << 3) & (tmemSize - 1);
+        struct {
+            uint32_t texels = 0, upper = 0, palette = 0, tlut = 0;
+            uint16_t width = 0, height = 0, line = 0, tmem = 0;
+            uint8_t siz = 0, fmt = 0, palettIndex = 0, pad = 0;
+        } key;
+
+        if (height == 0) {
+            return 0;
+        }
+
+        key.texels = spanTag(tags, tmemAddress, drawBytesTotal, tmemSize);
+        if (key.texels == 0) {
+            return 0;
+        }
+
+        if (RGBA32) {
+            key.upper = spanTag(tags, tmemAddress + tmemSize, drawBytesTotal, TMEMBytes);
+            if (key.upper == 0) {
+                return 0;
+            }
+        }
+
+        if (usesTLUT) {
+            const bool CI4 = (loadTile.siz == G_IM_SIZ_4b);
+            const uint32_t paletteAddress = (TMEMBytes >> 1) + (CI4 ? (loadTile.palette << 7) : 0);
+            key.palette = spanTag(tags, paletteAddress, CI4 ? 0x80 : 0x800, TMEMBytes);
+            if (key.palette == 0) {
+                return 0;
+            }
+        }
+
+        key.tlut = tlut;
+        key.width = width;
+        key.height = height;
+        key.line = loadTile.line;
+        key.tmem = loadTile.tmem;
+        key.siz = loadTile.siz;
+        key.fmt = loadTile.fmt;
+        key.palettIndex = loadTile.palette;
+        const uint64_t keyHash = XXH3_64bits(&key, sizeof(key));
+        return (keyHash != 0) ? keyHash : 1;
+    }
