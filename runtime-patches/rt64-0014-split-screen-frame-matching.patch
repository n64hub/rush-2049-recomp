+#if !defined(__EMSCRIPTEN__)
+    // Runs the jobs of a call on the calling thread and on helpers kept for it, and returns when all are done.
+    class SceneMatchPool {
+    public:
+        static SceneMatchPool &get() {
+            // Never destroyed: its threads wait on it until the process ends.
+            static SceneMatchPool *pool = new SceneMatchPool();
+            return *pool;
+        }
+
+        void run(uint32_t jobCount, const std::function<void(uint32_t)> &jobFunction) {
+            uint64_t runGeneration;
+            {
+                std::scoped_lock<std::mutex> lock(mutex);
+                job = &jobFunction;
+                count = jobCount;
+                next = 0;
+                done = 0;
+                runGeneration = ++generation;
+            }
+
+            wakeCondition.notify_all();
+            work(runGeneration);
+
+            std::unique_lock<std::mutex> lock(mutex);
+            doneCondition.wait(lock, [&]() { return done == count; });
+            job = nullptr;
+        }
+
+    private:
+        static constexpr uint32_t HelperCount = 3;
+        std::mutex mutex;
+        std::condition_variable wakeCondition;
+        std::condition_variable doneCondition;
+        const std::function<void(uint32_t)> *job = nullptr;
+        uint32_t count = 0;
+        uint32_t next = 0;
+        uint32_t done = 0;
+        uint64_t generation = 0;
+
+        SceneMatchPool() {
+            for (uint32_t i = 0; i < HelperCount; i++) {
+                std::thread([this]() { helperLoop(); }).detach();
+            }
+        }
+
+        void work(uint64_t runGeneration) {
+            std::unique_lock<std::mutex> lock(mutex);
+            while ((generation == runGeneration) && (next < count)) {
+                const uint32_t index = next++;
+                const std::function<void(uint32_t)> *runJob = job;
+                lock.unlock();
+                (*runJob)(index);
+                lock.lock();
+                done++;
+                if (done == count) {
+                    doneCondition.notify_all();
+                }
+            }
+        }
+
+        void helperLoop() {
+            uint64_t seenGeneration = 0;
+            while (true) {
+                {
+                    std::unique_lock<std::mutex> lock(mutex);
+                    wakeCondition.wait(lock, [&]() { return generation != seenGeneration; });
+                    seenGeneration = generation;
+                }
+
+                work(seenGeneration);
+            }
+        }
+    };
+#endif
