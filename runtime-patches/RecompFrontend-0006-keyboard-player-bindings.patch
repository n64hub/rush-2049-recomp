+// A controller player who also has the keyboard: player 1 while nobody has been given it.
+static bool controller_player_has_keyboard(int player_index) {
+    return recompinput::players::get_player_input_device(player_index) == recompinput::InputDevice::Controller &&
+        recompinput::profiles::get_input_profile_for_player(player_index, recompinput::InputDevice::Keyboard) >= 0;
+}
