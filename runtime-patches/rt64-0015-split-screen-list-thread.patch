+        // Rush 2049 patch: inline, as each triangle a list draws calls several of them (RSP::drawIndexedTri()).
+        FixedRect() {
+            reset();
+        }
+
+        FixedRect(int32_t ulx, int32_t uly, int32_t lrx, int32_t lry) : ulx(ulx), uly(uly), lrx(lrx), lry(lry) { }
+
+        void reset() {
+            ulx = INT32_MAX;
+            uly = INT32_MAX;
+            lrx = INT32_MIN;
+            lry = INT32_MIN;
+        }
+
+        bool isEmpty() const {
+            return isNull() || (lrx == ulx) || (lry == uly);
+        }
+
+        bool isNull() const {
+            return (ulx > lrx) || (uly > lry);
+        }
+
+        void merge(const FixedRect &rect) {
+            assert(!rect.isNull());
+            ulx = (rect.ulx < ulx) ? rect.ulx : ulx;
+            uly = (rect.uly < uly) ? rect.uly : uly;
+            lrx = (rect.lrx > lrx) ? rect.lrx : lrx;
+            lry = (rect.lry > lry) ? rect.lry : lry;
+        }
+
         FixedRect scaled(float x, float y) const;
 
         // Intersections can result in invalid rects if they don't overlap. Check if they're not null after using this.
-        FixedRect intersection(const FixedRect &rect) const;
+        FixedRect intersection(const FixedRect &rect) const {
+            if (!isNull() && !rect.isNull()) {
+                return {
+                    (ulx > rect.ulx) ? ulx : rect.ulx,
+                    (uly > rect.uly) ? uly : rect.uly,
+                    (lrx < rect.lrx) ? lrx : rect.lrx,
+                    (lry < rect.lry) ? lry : rect.lry
+                };
+            }
+            else {
+                return FixedRect();
+            }
+        }
+
         bool contains(int32_t x, int32_t y) const;
         bool fullyInside(const FixedRect &rect) const;
         int32_t left(bool ceil) const;
